 390          
 391          void log_event(unsigned int temp, unsigned char state)
 392          {
 393   1          unsigned int addr;
 394   1          unsigned char hours, minutes, seconds;
 395   1          unsigned char day, month, year;
 396   1          unsigned char count;
 397   1          
 398   1          rtc_read_time(&hours, &minutes, &seconds);
 399   1          rtc_read_date(&day, &month, &year);
 400   1          
 401   1          count = eeprom_read(0x0000);
 402   1          event_count = count;
 403   1          
 404   1          addr = 0x0010 + (count * 8);
 405   1          
 406   1          if(count >= 62)
 407   1          {
 408   2              count = 0;
 409   2              addr = 0x0010;
 410   2          }
 411   1          
 412   1          eeprom_write(addr, (unsigned char)(temp & 0xFF));
 413   1          eeprom_write(addr + 1, (unsigned char)(temp >> 8));
 414   1          eeprom_write(addr + 2, state);
 415   1          eeprom_write(addr + 3, seconds);
 416   1          eeprom_write(addr + 4, minutes);
 417   1          eeprom_write(addr + 5, hours);
 418   1          eeprom_write(addr + 6, day);
 419   1          eeprom_write(addr + 7, month);
 420   1          
 421   1          count++;
 422   1          eeprom_write(0x0000, count);
 423   1          event_count = count;
 424   1      }
